<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HardwareScope</AssemblyName>
    <RootNamespace>HardwareScope.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Product>HardwareScope</Product>
    <Description>轻量电脑硬件与性能监控</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HardwareScope.Core/HardwareScope.Core.csproj" />
    <Resource Include="Assets/app.ico" />
  </ItemGroup>
</Project>
